<?xml version="1.0" encoding="utf-8"?>
<!-- Google TV home and move/remove surfaces use android:banner, not android:icon.
     Reuse the approved mascot instead of a screenshot of playback/navigation UI. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Intrinsic 16:9 bounds prevent Google TV from treating this as
         a square launcher icon in its home and app-management surfaces. -->
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#061426" />
        </shape>
    </item>
    <item
        android:width="88dp"
        android:height="88dp"
        android:gravity="center"
        android:drawable="@drawable/ic_bousygram_mascot" />
</layer-list>
